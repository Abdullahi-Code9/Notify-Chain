    {
      "name": "Templates",
      "description": "Notification template CRUD. Templates support Handlebars-style `{{variable}}` substitution.",
      "item": [
        {
          "name": "Create template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response has id', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.id).to.be.a('number');",
                  "  pm.collectionVariables.set('template_id', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uniqueKey\": \"transfer-alert-v1\",\n  \"name\": \"Transfer Alert\",\n  \"description\": \"Fired when a token transfer is detected on-chain\",\n  \"channelType\": \"discord\",\n  \"bodyTemplate\": \"**Transfer detected** — {{amount}} XLM from {{from}} to {{to}}\",\n  \"subjectTemplate\": \"New Transfer: {{amount}} XLM\",\n  \"variables\": [\"amount\", \"from\", \"to\"],\n  \"defaultValues\": { \"amount\": \"0\" },\n  \"createdBy\": \"postman-test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/templates",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "templates"]
            },
            "description": "Create a new notification template.\n\nRequired fields: `uniqueKey`, `name`, `channelType`, `bodyTemplate`\n\n`channelType` must be one of: `discord`, `webhook`, `email`, `sms`\n\nThe `template_id` collection variable is updated on success."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"id\": 1, \"uniqueKey\": \"transfer-alert-v1\" }"
            },
            {
              "name": "400 Bad Request — missing fields",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"error\": \"Missing required fields: uniqueKey, name, channelType, bodyTemplate\" }"
            },
            {
              "name": "409 Conflict — duplicate unique key",
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"error\": \"Template with this unique key already exists\" }"
            }
          ]
        },
