                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key",    "value": "{{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"executeAt\": \"2026-12-01T09:00:00.000Z\",\n  \"targetRecipient\": \"https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN\",\n  \"notificationType\": \"discord\",\n  \"payload\": {\n    \"content\": \"Scheduled notification from NotifyChain\",\n    \"embeds\": [\n      {\n        \"title\": \"Event Alert\",\n        \"description\": \"A monitored contract event occurred.\",\n        \"color\": 5814783\n      }\n    ]\n  },\n  \"priority\": 5,\n  \"maxRetries\": 3,\n  \"metadata\": {\n    \"source\": \"postman-test\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/schedule",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "schedule"]
            },
            "description": "Schedule a notification for future delivery.\n\nRequired fields:\n- `executeAt` — ISO 8601 datetime (UTC)\n- `targetRecipient` — delivery URL (Discord webhook, etc.)\n- `payload` — notification body\n\nOptional:\n- `notificationType` — `discord` (default)\n- `priority` — 1 (high) to 10 (low)\n- `maxRetries` — retry budget (default: 3)\n- `metadata` — arbitrary key/value pairs"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"id\": 42 }"
            },
            {
              "name": "400 Bad Request — missing fields",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{ \"error\": \"Missing required fields: executeAt, payload, targetRecipient\", \"code\": \"MISSING_FIELDS\" }"
            }
          ]
        },
        {
          "name": "Get scheduled notification",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/schedule/{{schedule_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "schedule", "{{schedule_id}}"]
            },
            "description": "Fetch a single scheduled notification by its numeric ID.\n`schedule_id` is set automatically when 'Schedule a notification' is run first."
          },
          "response": []
