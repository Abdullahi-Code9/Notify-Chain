# =============================================================================
# NotifyChain listener integration examples — environment variables
# Copy to `.env` and fill in real values. Load them with:
#   node --env-file=.env js/01-setup-and-config.mjs       (Node >= 20.6)
# or export them in your shell before running an example.
#
# All variables below are OPTIONAL — the examples fall back to safe defaults so
# they run standalone. Variables that only matter once a listener is running are
# marked "(listener-backed)".
# =============================================================================

# Base URL of the listener HTTP API.
# Maps to the listener's EVENTS_API_PORT (default 8787).
EVENTS_API_BASE_URL=http://localhost:8787

# API key sent in the `X-API-Key` header.
# Must match one of the listener's API_KEYS entries, e.g.
#   API_KEYS=[{"key":"sk_dev_local","name":"examples"}]
# Leave empty when the listener runs with no API keys configured (dev/local mode).
EVENTS_API_KEY=

# -----------------------------------------------------------------------------
# Webhook signature verification (listener-backed)
# These mirror the listener's WEBHOOK_SECRETS config:
#   WEBHOOK_SECRETS=[{"id":"default","secret":"whsec_..."}]
# -----------------------------------------------------------------------------

# Shared secret used to HMAC-SHA256-sign webhook payloads.
WEBHOOK_SECRET=whsec_example_secret

# Key id sent in the `X-Webhook-Key-Id` header; must match the secret's id.
WEBHOOK_KEY_ID=default

# Maximum accepted age, in seconds, of a webhook timestamp (listener default 300).
WEBHOOK_TIMESTAMP_MAX_AGE_SECONDS=300

# -----------------------------------------------------------------------------
# Example harness only (not read by the listener)
# -----------------------------------------------------------------------------

# Port the local demo receiver in js/03-notifications-consumption.mjs binds to.
EXAMPLE_RECEIVER_PORT=8790
