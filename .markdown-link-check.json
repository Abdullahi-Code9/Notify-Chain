{
  "ignorePatterns": [
    {
      "pattern": "^https?://"
    },
    {
      "pattern": "^http?://"
    },
    {
      "pattern": "^#"
    },
    {
      "pattern": "^mailto:"
    },
    {
      "pattern": "^ftp://"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "./"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com", "https://www.github.com"],
      "headers": {
        "User-Agent": "markdown-link-check/1.0"
      }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 2,
  "fallbackRetryDelay": "10s",
  "aliveStatusCodes": [200, 206, 403, 429]
}
